# .env.example — EduSaarthi AI backend environment variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#

# -----------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------

# Your OpenRouter API key — obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# OpenRouter model id — see https://openrouter.ai/models
# Must support tool/function calling for the agent tools to work.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# OpenRouter API base URL (OpenAI-compatible Chat Completions endpoint).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Path to the JSON knowledge base (relative to repo root or absolute).
DATA_PATH=data/schemes.json

# Flask server settings
HOST=0.0.0.0
PORT=5500
FLASK_DEBUG=false

# Agent safety limits
MAX_ITERATIONS=8          # maximum tool-call rounds per request
MAX_SEARCH_RESULTS=10     # maximum scheme records per search
MAX_MESSAGE_LENGTH=4000   # maximum user message length (chars)
MAX_ANSWER_LENGTH=8000    # maximum answer length returned to client

# Deadline staleness threshold (days).
# Deadlines not checked within this window are flagged as 'stale'.
DEADLINE_STALE_DAYS=30

# Application version (surfaced on GET /health)
APP_VERSION=1.0.0
